import subprocess
import time

class LocalSewerPipe:
    """
    Sewer Pipe IPC v1.1 (Local Edition)
    Optimized for internal ADB loopback (127.0.0.1:5555)
    """
    def __init__(self, adb_id="127.0.0.1:5555"):
        self.base_adb = ["adb", "-s", adb_id, "shell"]
        self.tmp = "/data/local/tmp"

    def query(self, cmd, timeout=3.0):
        # 1. Clear old debris
        subprocess.run(self.base_adb + [f"rm -f {self.tmp}/a.ready"], capture_output=True)
        
        # 2. Hardened Question Posting (Literal Command Delivery)
        setup_cmd = (
            f"cat << 'EOF' > {self.tmp}/q.tmp\n"
            f"{cmd}\n"
            f"EOF\n"
            f"mv {self.tmp}/q.tmp {self.tmp}/q.ready"
        )
        subprocess.run(self.base_adb + [setup_cmd], capture_output=True, text=True)
        
        # 3. Polling for the answer
        start_time = time.time()
        while (time.time() - start_time) < timeout:
            check = subprocess.run(self.base_adb + [f"ls {self.tmp}/a.ready"], 
                                   capture_output=True, text=True)
            
            if "a.ready" in check.stdout:
                # 4. Fetch and Clean
                fetch_cmd = f"cat {self.tmp}/a.ready && rm -f {self.tmp}/a.ready"
                result = subprocess.run(self.base_adb + [fetch_cmd], 
                                        capture_output=True, text=True)
                return result.stdout.strip()
            
            time.sleep(0.1)
            
        return "ERR_TIMEOUT: LOCAL_ADB_NOT_RESPONDING"

# --- SYNDICATE INITIALIZATION ---
sewer = LocalSewerPipe()

# Example: Ask the local system for its heartbeat
print(f"[*] Local Load: {sewer.query('cat /proc/loadavg')}")
