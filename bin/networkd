#!/data/data/com.termux/files/usr/bin/bash

# -------------------------------------------------------------------
#  Networkd — System UID Network Monitor (Daemon)
# -------------------------------------------------------------------
source lib/miuiserperuser_common.sh 2>/dev/null || true
fugitoid_log() { echo "[$(date)] $*" >> logs/networkd.log; }

PID_FILE="pipes/networkd.pid"
mkdir -p pipes logs
echo $$ > "$PID_FILE"

run_shell() {
    if [[ -x "$HOME/.shizuku/rish" ]]; then
        "$HOME/.shizuku/rish" -c "$*" 2>/dev/null
    elif command -v adb >/dev/null 2>&1; then
        adb shell "$@" 2>/dev/null
    fi
}

# System UIDs we care about (MIUI bloat + core system)
WATCH_UIDS="1000 1001 1010 1011 1013 1019 1020 1021 1041 1073"

fugitoid_log "🚀 Networkd started — watching system UIDs: $WATCH_UIDS"

declare -A seen_connections

while true; do
    # Get current established connections with UID > 1000
    run_shell "cat /proc/net/tcp /proc/net/tcp6" 2>/dev/null | while read line; do
        [[ "$line" =~ ^[[:space:]]*[0-9]+: ]] || continue
        local uid=$(echo "$line" | awk '{print $8}')
        [[ -z "$uid" || "$uid" -lt 1000 ]] && continue

        local remote=$(echo "$line" | awk '{print $3}')
        local remote_hex=$(echo "$remote" | cut -d: -f1)
        local port_hex=$(echo "$remote" | cut -d: -f2)
        [[ "$remote_hex" =~ ^[0-9A-Fa-f]{8}$ ]] || continue

        local ip=$(printf "%d.%d.%d.%d" 0x${remote_hex:6:2} 0x${remote_hex:4:2} 0x${remote_hex:2:2} 0x${remote_hex:0:2})
        [[ "$ip" == "0.0.0.0" || "$ip" == "127.0.0.1" ]] && continue

        local key="${uid}:${ip}:${port_hex}"
        if [[ -z "${seen_connections[$key]}" ]]; then
            seen_connections[$key]=1
            local name=$(run_shell "grep '^$uid ' /data/system/packages.list | cut -d' ' -f1" | head -1)
            [[ -z "$name" ]] && name="System UID $uid"
            
            fugitoid_log "🔗 NEW CONNECTION: $name → $ip:$((0x$port_hex))"
            
            # Alert on unexpected MIUI system UIDs talking externally
            if [[ " $WATCH_UIDS " == *" $uid "* ]] && [[ "$ip" != 192.168.* ]] && [[ "$ip" != 10.* ]] && [[ "$ip" != 172.1[6-9].* ]] && [[ "$ip" != 172.2[0-9].* ]] && [[ "$ip" != 172.3[0-1].* ]]; then
                fugitoid_log "⚠️ ALERT: System UID $uid ($name) connected to external IP $ip"
            fi
        fi
    done

    sleep 60
done
