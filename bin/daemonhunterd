fi
# ------------------------------------------------------------
#  Active Sentinel Loop
# Handle --add flag for external tools

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
if [[ "$1" == "--add" ]]; then

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
    pkg="$2"

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
    action="${3:-deep_starve}"

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
    echo "$pkg|$action|" >> data/daemonhunter_brain.txt

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
    echo "✅ $pkg → $action added to brain"

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
    exit 0

# Educational gate: require Peruse Control + RAM Slammer
if [[ ! -f data/.peruse_completed ]]; then
    echo "❌ Peruse Control training not completed."
    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
