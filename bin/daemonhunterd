# ------------------------------------------------------------
apply_action() {
    local full_pkg="$1"
    local action="$2"
    local base_pkg="${full_pkg%%:*}"

    case "$action" in
        kill)
            run_shell am force-stop "$full_pkg"
            fugitoid_log "DaemonHunter" "ENFORCE" "Killed $full_pkg"
            ;;
        freeze)
            run_shell pm suspend "$base_pkg"
            set_oom_max "$full_pkg"
            fugitoid_log "DaemonHunter" "ENFORCE" "Frozen $base_pkg"
            ;;
        starve)
            run_shell pm disable-user --user 0 "$base_pkg"
            run_shell am force-stop "$full_pkg"
            set_oom_max "$full_pkg"
            fugitoid_log "DaemonHunter" "ENFORCE" "Starved $base_pkg"
            ;;
        restrict)
            for op in 27 26 4 6 14 1 60; do
                run_shell cmd appops set "$full_pkg" "$op" ignore
            done
            run_shell am force-stop "$full_pkg"
            set_oom_max "$full_pkg"
            fugitoid_log "DaemonHunter" "ENFORCE" "Restricted $full_pkg"
            ;;
        deep_starve)
            run_shell pm suspend "$base_pkg"
            run_shell pm disable-user --user 0 "$base_pkg"
            run_shell am force-stop "$full_pkg"
            run_shell pm clear "$base_pkg"
            for op in 63 64 40 59 27 26 4 6 14 1 60; do
                run_shell cmd appops set "$full_pkg" "$op" ignore
            done
            set_oom_max "$full_pkg"
            run_shell am force-stop "$full_pkg"
            fugitoid_log "DaemonHunter" "ENFORCE" "Deep starved $base_pkg"
            ;;
        *)
            run_shell am force-stop "$full_pkg"
            ;;
    esac
}

