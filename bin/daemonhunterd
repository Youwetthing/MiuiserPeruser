    echo "   Run: ./tools/peruse_control.sh (option 1)"
    exit 1
fi
if [[ ! -f data/.ram_slammer_used ]]; then
    echo "❌ RAM Slammer has not been used yet."
    echo "   Run: ./bin/watch_ram_slammers.sh"
    exit 1
fi
# ------------------------------------------------------------
while true; do
    sleep "$CHECK_INTERVAL"
    
    load_brain
    for pkg in "${!brain_actions[@]}"; do
        if run_shell "pgrep -f $pkg" > /dev/null 2>&1; then
            action="${brain_actions[$pkg]}"
            fugitoid_log "DaemonHunter" "RESPAWN" "$pkg detected — reapplying $action"
            apply_action "$pkg" "$action"
            db_log_action "DaemonHunter" "$pkg" "$action" "respawn"
        fi
    done
done
# --- LYMPHATIC INTEGRATION ---
start_lymph_drainage() {
    (
        while true; do
            while IFS='|' read -r pkg action ts; do
                [ -z "$pkg" ] && continue
                adb shell cmd appops set "$pkg" RUN_IN_BACKGROUND ignore < /dev/null 2>/dev/null
                adb shell am force-stop "$pkg" < /dev/null >/dev/null 2>&1
            done < "$HOME/MiuiserPeruser/data/daemonhunter_brain.txt"
            sleep 20
        done
    ) &
}
