# ------------------------------------------------------------
declare -A brain_actions

load_brain() {
    brain_actions=()
    while IFS='|' read -r pkg action extra; do
        [[ -z "$pkg" || "$pkg" =~ ^# ]] && continue
        brain_actions["$pkg"]="$action"
    done < "$BRAIN"
    
    while read -r line; do
        [[ -z "$line" || "$line" =~ ^# || "$line" == *"|"* ]] && continue
        [[ -z "${brain_actions[$line]}" ]] && brain_actions["$line"]="kill"
    done < "$BRAIN"
}

apply_all_actions() {
    load_brain
    fugitoid_log "DaemonHunter" "SWEEP" "Applying ${#brain_actions[@]} actions"
    for pkg in "${!brain_actions[@]}"; do
        apply_action "$pkg" "${brain_actions[$pkg]}"
    done
    fugitoid_log "DaemonHunter" "SWEEP" "Sweep complete"
}

