# ------------------------------------------------------------
set_oom_max() {
    local pkg="$1"
    local pids=$(run_shell "pgrep -f $pkg")
    if [[ -n "$pids" ]]; then
        for pid in $pids; do
            run_shell "echo 1000 > /proc/$pid/oom_score_adj" 2>/dev/null
        done
    fi
}

