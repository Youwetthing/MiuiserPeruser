// Add at top of file
static int debug_mode = 0;

static void debug(const char *fmt, ...) {
    if (!debug_mode) return;
    va_list args;
    va_start(args, fmt);
    fprintf(stderr, "DEBUG: ");
    vfprintf(stderr, fmt, args);
    fprintf(stderr, "\n");
    va_end(args);
}

#define STATE_FILE "/data/data/com.termux/files/home/.local/tmnt/state/burne.state"

static void write_state(const char *key, const char *value) {
    FILE *f = fopen(STATE_FILE, "a");
    if (!f) return;
    fprintf(f, "%s=%s\n", key, value);
    fclose(f);
}

static void reset_state() {
    FILE *f = fopen(STATE_FILE, "w");
    if (f) fclose(f);
}

/* ------------------------------
   1. Detect MIUI killing daemons
   ------------------------------ */
static void check_process_survival() {
    char *resp = krang_send_command("ps -A | grep tmnt");
    if (!resp) return;

    int count = 0;
    char *line = strtok(resp, "\n");
    while (line) {
        if (strstr(line, "d")) count++;
        line = strtok(NULL, "\n");
    }

    if (count < 6) {
        fugitoid_log("WARN", "MIUI may have killed one or more TMNT daemons.");
        write_state("daemon_kill", "1");
    } else {
        write_state("daemon_kill", "0");
    }

    free(resp);
}

/* ------------------------------
   2. Detect MIUI power policy
   ------------------------------ */
static void check_power_mode() {
    FILE *f = fopen("/sys/kernel/miui_battery/power_mode", "r");
    if (!f) {
        write_state("power_mode", "unknown");
        return;
    }

    char buf[32];
    fgets(buf, sizeof(buf), f);
    fclose(f);

    write_state("power_mode", buf);
}

/* ------------------------------
   3. Detect MIUI AppOps changes
   ------------------------------ */
static void check_appops() {
    char cmd[128];
    snprintf(cmd, sizeof(cmd), "appops get %d RUN_IN_BACKGROUND", getuid());

    char *resp = krang_send_command(cmd);
    if (!resp) return;

    if (strstr(resp, "deny")) {
        fugitoid_log("WARN", "MIUI restricted RUN_IN_BACKGROUND.");
        write_state("appops_bg", "denied");
    } else {
        write_state("appops_bg", "allowed");
    }

    free(resp);
}

/* ------------------------------
   4. Detect MIUI thermal policy
   ------------------------------ */
static void check_thermal_policy() {
    FILE *f = fopen("/sys/class/thermal/thermal_message/level", "r");
    if (!f) {
        write_state("thermal_policy", "restricted");
        return;
    }

    char buf[32];
    fgets(buf, sizeof(buf), f);
    fclose(f);

    write_state("thermal_policy", buf);
}

