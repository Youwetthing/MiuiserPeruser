/* ------------------------------
   7. Detect MIUI app freeze
   ------------------------------ */
static void check_freeze() {
    FILE *f = fopen("/dev/stune/background/tasks", "r");
    if (!f) {
        write_state("freeze", "unknown");
        return;
    }

    char buf[256];
    int frozen = 0;

    while (fgets(buf, sizeof(buf), f)) {
        frozen++;
    }

    fclose(f);

    if (frozen > 0) {
        write_state("freeze", "1");
        fugitoid_log("WARN", "MIUI may be freezing background tasks.");
    } else {
        write_state("freeze", "0");
    }
}

