#!/data/data/com.termux/files/usr/bin/bash

CONFIG="data/miui_hyperos_bloat_list.conf"

is_category() {
    local pkg="$1"
    local cat="$2"
    grep -q "^$cat=\( pkg \)" "$CONFIG" 2>/dev/null
}

list_safe() {
    echo "=== SAFE TO DISABLE / UNINSTALL ==="
    grep "^SAFE=" "$CONFIG" | cut -d= -f2 | sort
    echo ""
    echo "=== CULL TARGETS (background killers) ==="
    grep "^CULL=" "$CONFIG" | cut -d= -f2 | sort
}

cull_background() {
    echo "🧹 Peruse_Control is culling background bloat..."
    for pkg in $(grep "^CULL=" "$CONFIG" | cut -d= -f2); do
        if pm list packages | grep -q "$pkg"; then
            echo "→ Force-stopping $pkg"
            am force-stop "$pkg" 2>/dev/null || true
        fi
    done
    echo "✅ Background cull complete (only safe targets touched)"
}

status() {
    echo "Peruse_Control Status"
    echo "─────────────────────"
    echo "Critical packages protected: $(grep -c "^CRITICAL=" "$CONFIG")"
    echo "Bootloop-risk packages: $(grep -c "^BOOTLOOP=" "$CONFIG")"
    echo "Safe to disable: $(grep -c "^SAFE=" "$CONFIG")"
    echo "Background cull targets: $(grep -c "^CULL=" "$CONFIG")"
    echo ""
    echo "Use: ./tools/peruse_control cull    → cull background bloat"
    echo "     ./tools/peruse_control safe     → list safe packages"
}

case "$1" in
    cull) cull_background ;;
    safe|list) list_safe ;;
    status|help|--help) status ;;
    *)
        echo "Peruse_Control — MIUI/HyperOS Smart App Manager"
        echo "Usage: ./tools/peruse_control [command]"
        echo ""
        echo "Commands:"
        echo "  status     → show protection summary"
        echo "  safe       → list safe-to-disable packages"
        echo "  cull       → intelligently cull background bloat"
        echo ""
        status
        ;;
esac
