# App‑aware connections (replaces active_connections if desired)
app_aware_connections() {
    clear
    echo -e "${CYAN}${TL}$(printf '%*s' 68 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${CYAN}${VL}${RESET} ${BOLD}${WHITE}🌐 APP‑AWARE NETWORK CONNECTIONS${RESET}$(printf '%*s' 34) ${CYAN}${VL}${RESET}"
    echo -e "${CYAN}${BL}$(printf '%*s' 68 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    local map_file="data/uid_package_map.txt"
    if [[ ! -f "$map_file" ]] || [[ $(find "$map_file" -mmin +60 2>/dev/null) ]]; then
        echo -e "${GRAY}⏳ Updating UID map...${RESET}"
        run_shell "pm list packages -U" 2>/dev/null | sed -n 's/package:\(.*\) uid:\(.*\)/\2 \1/p' > "$map_file"
    fi
    local connections=$(run_shell "cat /proc/net/tcp /proc/net/tcp6" 2>/dev/null); local count=0
    while read line; do
        [[ "$line" =~ ^[[:space:]]*[0-9]+: ]] || continue; local uid=$(echo "$line" | awk '{print $8}'); [[ -z "$uid" || "$uid" == "0" ]] && continue
        local remote=$(echo "$line" | awk '{print $3}'); local remote_hex=$(echo "$remote" | cut -d: -f1); local port_hex=$(echo "$remote" | cut -d: -f2)
        [[ "$remote_hex" =~ ^[0-9A-Fa-f]{8}$ ]] || continue; [[ "$port_hex" =~ ^[0-9A-Fa-f]+$ ]] || continue
        local ip=$(printf "%d.%d.%d.%d" 0x${remote_hex:6:2} 0x${remote_hex:4:2} 0x${remote_hex:2:2} 0x${remote_hex:0:2}); local port=$((0x$port_hex))
        [[ "$ip" == "0.0.0.0" || "$ip" == "127.0.0.1" ]] && continue
        local pkg=$(grep "^$uid " "$map_file" 2>/dev/null | head -1 | cut -d' ' -f2); [[ -z "$pkg" ]] && pkg="unknown (UID $uid)"
        printf "${DARK}%-18s${RESET} : ${WHITE}%-25s${RESET} ${YELLOW}%s${RESET}\n" "$ip" "$port" "$pkg"; count=$((count + 1))
    done <<< "$connections"
    echo ""; echo -e "${CYAN}Total active connections: ${GREEN}${count}${RESET}"; echo ""
    read -n 1 -s -p "Press any key to return..."
}

run_shell() {
    if [[ -x "$HOME/.shizuku/rish" ]]; then "$HOME/.shizuku/rish" -c "$*" 2>/dev/null
    elif command -v adb >/dev/null 2>&1; then adb shell "$@" 2>/dev/null
    else return 1; fi
}

view_cache() {
    clear; echo -e "${YELLOW}File Watchlist – what files are being checked${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
    if [ -f ~/.miuiserperuser_integrity_cache ]; then
        echo "These are the SHA256 hashes of monitored files. If a file changes, you'll get a THREAT alert."; echo ""
        cat ~/.miuiserperuser_integrity_cache | while read line; do echo -e "${CYAN}$line${RESET}"; done
    else echo "No cache yet. Run a scan first."; fi
    echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"; read -p "Press Enter..."
}

