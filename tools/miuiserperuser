# ═══════════════════════════════════════════════════════════════════════════
MODULE_ORDER=("integrity" "memory" "network" "behavior" "hook" "kernel" "miui")
declare -A MODULE_NAMES=(
    ["memory"]="Memory Scan"; ["network"]="Network Monitor"; ["integrity"]="File Watch"
    ["behavior"]="Process Behavior"; ["hook"]="Hook Detection"; ["kernel"]="Kernel Analysis"; ["miui"]="MIUI Monitor"
)
declare -A MODULE_PUNS=(
    ["memory"]="Neil Daemon (Sweet Caroline)"; ["network"]="H-TTPS Daemon Hunters"; ["integrity"]="Bl-UUID Daemons"
    ["behavior"]="Daemons Are Forever"; ["hook"]="Princess Dae(Mon)"; ["kernel"]="Daemons Are a Girl's Best Friend"; ["miui"]="Matt Daemon"
)

truncate_pun() { local pun="$1"; local max_len=42; [ ${#pun} -gt $max_len ] && echo "${pun:0:$((max_len-3))}..." || echo "$pun"; }

show_status() {
    clear
    echo -e "${MAGENTA}${TL}$(printf '%*s' 76 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${MAGENTA}${VL}${RESET} ${BOLD}${WHITE}⚡ MIUISERPERUSER — TERMINAL DOJO ⚡${RESET}$(printf '%*s' 28) ${MAGENTA}${VL}${RESET}"
    echo -e "${MAGENTA}${VL}${RESET} ${DIM}${GRAY}system integrity · memory · network · behavior · hook · kernel · miui${RESET} ${MAGENTA}${VL}${RESET}"
    echo -e "${MAGENTA}${BL}$(printf '%*s' 76 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    echo -e "${CYAN}${BOLD}STATUS BAR${RESET}   Daemon: $(check_service)   ${VL}   Last Scan: ${PURPLE}$(last_scan_time)${RESET}   ${VL}   Threats Today: ${RED}$(threat_count_today)${RESET}"
    echo -e "              Memory: ${BLUE}$(get_memory_usage)${RESET}"
    echo ""
    echo -e "${YELLOW}${BOLD}CHOOSE YOUR FIGHTER${RESET}"
    echo -e "${DARK}${HL}$(printf '%*s' 76 | tr ' ' "${HL}")${RESET}"
    printf "  %-20s %-7s %s\n" "MODULE" "STATUS" "SIGNATURE MOVE"
    echo -e "${DARK}${HL}$(printf '%*s' 76 | tr ' ' "${HL}")${RESET}"
    for mod in "${MODULE_ORDER[@]}"; do
        state="${STATE[$mod]:-0}"; name="${MODULE_NAMES[$mod]}"; pun="${MODULE_PUNS[$mod]}"
        [ "$mod" = "network" ] && [ "$state" = "1" ] && name="$name (limited)"
        pun_display=$(truncate_pun "$pun")
        if [ "$state" = "1" ]; then
            printf "  ${GREEN}✓${RESET} %-18s ${GREEN}ON${RESET}      ${PINK}%s${RESET}\n" "$name" "$pun_display"
        else
            printf "  ${RED}✗${RESET} %-18s ${RED}OFF${RESET}     ${DARK}%s${RESET}\n" "$name" "$pun_display"
        fi
    done
    echo -e "${DARK}${HL}$(printf '%*s' 76 | tr ' ' "${HL}")${RESET}"
    echo ""
    echo -e "${CYAN}${BOLD}DOJO COMMANDS${RESET}"
    echo -e "  ${GREEN}A${RESET}) Scan menu (full/quick)     ${GREEN}B${RESET}) Toggle fighters"
    echo -e "  ${GREEN}C${RESET}) Live daemon feed             ${GREEN}D${RESET}) Start/stop daemon"
    echo -e "  ${GREEN}E${RESET}) View file watchlist           ${GREEN}F${RESET}) Process States"
    echo -e "  ${GREEN}G${RESET}) Device Info                  ${GREEN}H${RESET}) Exit"
    echo -e "  ${MAGENTA}T${RESET}) 🧰 TOOLBOX (Peruse, Battery, Hidden Settings, etc.)"
    echo -e "${DARK}${HL}$(printf '%*s' 76 | tr ' ' "${HL}")${RESET}"
    echo -n -e "${WHITE}▶${RESET} "
}

# ═══════════════════════════════════════════════════════════════════════════
#  SCAN SUBMENU
# ═══════════════════════════════════════════════════════════════════════════
scan_menu() {
    while true; do
        clear
        echo -e "${YELLOW}${TL}$(printf '%*s' 40 | tr ' ' "${HL}")${TR}${RESET}"
        echo -e "${YELLOW}${VL}${RESET} ${BOLD}SCAN MENU${RESET}$(printf '%*s' 30) ${YELLOW}${VL}${RESET}"
        echo -e "${YELLOW}${BL}$(printf '%*s' 40 | tr ' ' "${HL}")${BR}${RESET}"
        echo ""
        echo "  ${GREEN}1${RESET}) Full scan (detailed)"
        echo "  ${GREEN}2${RESET}) Quick scan (summary)"
        echo "  ${GREEN}3${RESET}) Show last scan snapshot"
        echo "  ${RED}X${RESET}) Return to main menu"
        echo ""
        read -p "> Choice: " scan_choice
        case $scan_choice in
            1)
                clear; echo -e "${YELLOW}Running full scan...${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                $CLIENT FULL_SCAN; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                echo -e "${PINK}Scan complete. Press any key to return.${RESET}"; read -n 1 -s ;;
            2)
                clear; echo -e "${YELLOW}Running quick scan...${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                $CLIENT QUICK_SCAN; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                echo -e "${PINK}Scan complete. Press any key to return.${RESET}"; read -n 1 -s ;;
            3)
                clear; echo -e "${YELLOW}Last Scan Snapshot${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                show_last_scan; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
                echo -e "${PINK}Snapshot end. Press any key to return.${RESET}"; read -n 1 -s ;;
            [Xx]) return ;;
            *) echo -e "${RED}Invalid choice${RESET}"; sleep 1 ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════════════
#  LIVE FEED
# ═══════════════════════════════════════════════════════════════════════════
live_feed() {
    clear
    echo -e "${CYAN}${TL}$(printf '%*s' 58 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${CYAN}${VL}${RESET} ${YELLOW}              LIVE DAEMON FEED (Ctrl+C to return)${RESET}            ${CYAN}${VL}${RESET}"
    echo -e "${CYAN}${BL}$(printf '%*s' 58 | tr ' ' "${HL}")${BR}${RESET}"
    trap 'echo -e "\n${CYAN}────────────────────────────────────────────────────────${RESET}"; return' INT
    tail -f "$LOG" | while read line; do
        if [[ "$line" == *"THREAT"* ]]; then echo -e "${RED}$line${RESET}"
        elif [[ "$line" == *"WARN"* ]]; then echo -e "${YELLOW}$line${RESET}"
        elif [[ "$line" == *"NETWORK"* ]]; then echo -e "${BLUE}$line${RESET}"
        elif [[ "$line" == *"MEMORY"* ]]; then echo -e "${PURPLE}$line${RESET}"
        else echo "$line"; fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════
#  TOGGLE FIGHTERS
# ═══════════════════════════════════════════════════════════════════════════
toggle_modules() {
    while true; do
        clear
        echo -e "${GREEN}${TL}$(printf '%*s' 58 | tr ' ' "${HL}")${TR}${RESET}"
        echo -e "${GREEN}${VL}${RESET} ${BOLD}${WHITE}CHOOSE YOUR FIGHTER — PICK YOUR SQUAD${RESET}$(printf '%*s' 16) ${GREEN}${VL}${RESET}"
        echo -e "${GREEN}${BL}$(printf '%*s' 58 | tr ' ' "${HL}")${BR}${RESET}"
        echo ""
        letters=()
        for idx in "${!MODULE_ORDER[@]}"; do
            mod="${MODULE_ORDER[$idx]}"; state="${STATE[$mod]:-0}"; name="${MODULE_NAMES[$mod]}"; pun="${MODULE_PUNS[$mod]}"
            pun_display=$(truncate_pun "$pun"); letter=$(printf "\\x$(printf %x $((65+idx)))"); letters+=("$letter")
            if [ "$state" = "1" ]; then
                echo -e "  ${GREEN}${letter})${RESET} $name ${GREEN}ON${RESET}  ${PINK}$pun_display${RESET}"
            else
                echo -e "  ${RED}${letter})${RESET} $name ${RED}OFF${RESET} ${DARK}$pun_display${RESET}"
            fi
        done
        echo ""; echo "  ${RED}X${RESET}) Return to main menu"; echo ""
        read -p "> Toggle which fighter? " choice
        [[ "$choice" == "X" || "$choice" == "x" ]] && return
        found=-1; for idx in "${!letters[@]}"; do [[ "${letters[$idx]}" == "$choice" ]] && { found=$idx; break; }; done
        if [ $found -ge 0 ]; then
            mod="${MODULE_ORDER[$found]}"; current_state="${STATE[$mod]:-0}"; new_state=$((1 - current_state))
            echo -n "Turn $([ $new_state -eq 1 ] && echo "ON" || echo "OFF")? (y/n) "; read confirm
            if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                $CLIENT TOGGLE $mod $([ $new_state -eq 1 ] && echo "on" || echo "off")
                STATE["$mod"]=$new_state; sed -i "/^$mod=/d" "$CONFIG"; echo "$mod=$new_state" >> "$CONFIG"; echo "Done."
            fi; sleep 1
        else echo "Invalid choice"; sleep 1; fi
    done
}

