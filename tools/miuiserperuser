# ═══════════════════════════════════════════════════════════════════════════
RED='\033[38;5;203m'
ORANGE='\033[38;5;214m'
YELLOW='\033[38;5;221m'
GREEN='\033[38;5;48m'
CYAN='\033[38;5;51m'
