#!/data/data/com.termux/files/usr/bin/bash

# MiuiserPeruser Dashboard – scan submenu (full/quick) under A

CLIENT="$HOME/MiuiserPeruser/tools/miuiserperuser-client"
CONFIG="$HOME/.miuiserperuser_config"
LOG="$HOME/miuiserperuser.log"
DAEMON="$HOME/MiuiserPeruser/build/src/daemon/miuiserperuser-daemon"

# Colours
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
PINK='\033[0;95m'
CYAN='\033[0;36m'
NC='\033[0m'

# First run: all modules on except kernel
if [ ! -f "$CONFIG" ]; then
    > "$CONFIG"
    echo "integrity=1" >> "$CONFIG"
    echo "memory=1" >> "$CONFIG"
    echo "network=1" >> "$CONFIG"
    echo "behavior=1" >> "$CONFIG"
    echo "hook=1" >> "$CONFIG"
    echo "kernel=0" >> "$CONFIG"
    echo "miui=1" >> "$CONFIG"
fi

# Read current states into array
declare -A STATE
while IFS='=' read -r mod val; do
    STATE["$mod"]="$val"
done < "$CONFIG"

check_service() {
    if pgrep -f "miuiserperuser-daemon" > /dev/null; then
        echo -e "${GREEN}●${NC} Running"
        return 0
    else
        echo -e "${RED}○${NC} Stopped"
        return 1
    fi
}

last_scan_time() {
    if [ -f "$LOG" ]; then
        # Look for any scan finished (full or quick)
        tail -n 50 "$LOG" | grep -E "(Full|Quick) scan finished" | tail -1 | cut -d' ' -f1-2
    else
        echo "Never"
    fi
}

threat_count_today() {
    if [ -f "$LOG" ]; then
        today=$(date +%Y-%m-%d)
        grep "$today" "$LOG" | grep -c "THREAT"
    else
        echo 0
    fi
}

get_memory_usage() {
    local mem_total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    local mem_avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    local swap_total=$(awk '/SwapTotal/ {print $2}' /proc/meminfo)
    local swap_free=$(awk '/SwapFree/ {print $2}' /proc/meminfo)
    local ram_used=0
    local swap_used=0
    if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ]; then
        ram_used=$(( 100 - (mem_avail * 100 / mem_total) ))
    fi
    if [ -n "$swap_total" ] && [ "$swap_total" -gt 0 ]; then
        swap_used=$(( (swap_total - swap_free) * 100 / swap_total ))
    else
        swap_used=0
    fi
    echo "RAM ${ram_used}% | Swap ${swap_used}%"
}

# Show last scan snapshot (any type)
show_last_scan() {
    if [ ! -f "$LOG" ]; then
        echo "No log file found."
        return
    fi
    # Find the last occurrence of a scan finished (full or quick)
    local end_line=$(grep -n -E "(Full|Quick) scan finished" "$LOG" | tail -1 | cut -d: -f1)
    if [ -z "$end_line" ]; then
        echo "No scans recorded yet."
        return
    fi
    # Find the preceding start line
    local start_line=$(head -n $end_line "$LOG" | grep -n -E "Starting (full|quick) system scan" | tail -1 | cut -d: -f1)
    if [ -z "$start_line" ]; then
        start_line=1
    fi
    sed -n "${start_line},${end_line}p" "$LOG"
}

# Background Processes – with command on its own line
background_processes() {
    local pids=()
    for pid in /proc/[0-9]*; do
        pid=${pid#/proc/}
        pids+=("$pid")
    done

    local count=0
    printf "%-6s %-15s %-6s %-8s %-7s %s\n" "PID" "NAME" "STATE" "CPU" "MEMORY" "COMMAND"
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"

    for pid in "${pids[@]}"; do
        local stat_file="/proc/$pid/stat"
        local status_file="/proc/$pid/status"
        local cmdline_file="/proc/$pid/cmdline"
        if [ ! -r "$stat_file" ] || [ ! -r "$status_file" ]; then
            continue
        fi

        local ppid=$(awk '{print $4}' "$stat_file" 2>/dev/null)
        local name=$(grep "^Name:" "$status_file" 2>/dev/null | awk '{print $2}')
        local cmdline=$(cat "$cmdline_file" 2>/dev/null | tr '\0' ' ' | sed 's/ $//')
        [ -z "$cmdline" ] && cmdline="[$name]"

        if [ "$ppid" = "1" ] || [[ "$name" =~ sv|log|getty|daemon|init|systemd ]]; then
            local utime=$(awk '{print $14}' "$stat_file" 2>/dev/null)
            local stime=$(awk '{print $15}' "$stat_file" 2>/dev/null)
            local total_time=$((utime + stime))
            local cpu_sec=$((total_time / 100))
            local cpu_min=$((cpu_sec / 60))
            cpu_sec=$((cpu_sec % 60))
            local cpu_time=$(printf "%02d:%02d" $cpu_min $cpu_sec)

            local mem_kb=$(grep "^VmRSS:" "$status_file" 2>/dev/null | awk '{print $2}')
            local mem=""
            if [ -n "$mem_kb" ]; then
                if [ "$mem_kb" -ge 1024 ]; then
                    mem="$(echo "scale=1; $mem_kb/1024" | bc)M"
                else
                    mem="${mem_kb}K"
                fi
            else
                mem="N/A"
            fi

            local state=$(awk '{print $3}' "$stat_file" 2>/dev/null)
            printf "%-6s %-15s %-6s %-8s %-7s\n" "$pid" "$name" "$state" "$cpu_time" "$mem"
            printf "      └─ %s\n" "$cmdline"
            ((count++))
        fi
    done
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "Total background processes: ${GREEN}${count}${NC}"
}

# Active Network Connections – snapshot
active_connections() {
    clear
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}              Active Network Connections (Snapshot)${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"

    local tmpfile=$(mktemp)
    local count=0

    get_package_name() {
        local uid=$1
        local pkg="?"
        if [ -f /data/system/packages.list ]; then
            pkg=$(awk -v u="$uid" '$2 == u {print $1; exit}' /data/system/packages.list 2>/dev/null)
        fi
        [ -z "$pkg" ] && pkg="?"
        echo "$pkg"
    }

    get_process_name() {
        local pid=$1
        if [ -r "/proc/$pid/cmdline" ]; then
            tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed 's/ $//'
        else
            echo "?"
        fi
    }

    # TCP
    if [ -r /proc/net/tcp ]; then
        while read line; do
            [[ "$line" =~ ^[[:space:]]*sl ]] && continue
            local local_hex=$(echo "$line" | awk '{print $2}')
            local rem_hex=$(echo "$line" | awk '{print $3}')
            local st=$(echo "$line" | awk '{print $4}')
            local uid=$(echo "$line" | awk '{print $8}')
            local inode=$(echo "$line" | awk '{print $10}')

            local local_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${local_hex:0:2} 0x${local_hex:3:2} 0x${local_hex:6:2} 0x${local_hex:9:2} 0x${local_hex:12} 2>/dev/null)
            local rem_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${rem_hex:0:2} 0x${rem_hex:3:2} 0x${rem_hex:6:2} 0x${rem_hex:9:2} 0x${rem_hex:12} 2>/dev/null)

            local pid=""
            for p in /proc/[0-9]*; do
                local p_pid=${p#/proc/}
                for fd in $p/fd/*; do
                    if [ -L "$fd" ]; then
                        local target=$(readlink "$fd")
                        if [[ "$target" == "socket:[$inode]" ]]; then
                            pid=$p_pid
                            break 2
                        fi
                    fi
                done
            done

            if [ -n "$pid" ]; then
                local proc_name=$(get_process_name "$pid")
                local pkg_name=$(get_package_name "$uid")
                local state_str=""
                case $st in
                    01) state_str="ESTABLISHED" ;;
                    02) state_str="SYN_SENT" ;;
                    03) state_str="SYN_RECV" ;;
                    04) state_str="FIN_WAIT1" ;;
                    05) state_str="FIN_WAIT2" ;;
                    06) state_str="TIME_WAIT" ;;
                    07) state_str="CLOSE" ;;
                    08) state_str="CLOSE_WAIT" ;;
                    09) state_str="LAST_ACK" ;;
                    0A) state_str="LISTEN" ;;
                    0B) state_str="CLOSING" ;;
                    *) state_str="UNKNOWN" ;;
                esac
                printf "TCP | %-21s -> %-21s | %-12s | PID %-6d | %s | %s\n" \
                    "$local_ip_port" "$rem_ip_port" "$state_str" "$pid" "${proc_name:0:30}" "$pkg_name" >> "$tmpfile"
                ((count++))
            fi
        done < /proc/net/tcp
    fi

    # UDP
    if [ -r /proc/net/udp ]; then
        while read line; do
            [[ "$line" =~ ^[[:space:]]*sl ]] && continue
            local local_hex=$(echo "$line" | awk '{print $2}')
            local rem_hex=$(echo "$line" | awk '{print $3}')
            local st=$(echo "$line" | awk '{print $4}')
            local uid=$(echo "$line" | awk '{print $8}')
            local inode=$(echo "$line" | awk '{print $10}')

            local local_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${local_hex:0:2} 0x${local_hex:3:2} 0x${local_hex:6:2} 0x${local_hex:9:2} 0x${local_hex:12} 2>/dev/null)
            local rem_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${rem_hex:0:2} 0x${rem_hex:3:2} 0x${rem_hex:6:2} 0x${rem_hex:9:2} 0x${rem_hex:12} 2>/dev/null)

            local pid=""
            for p in /proc/[0-9]*; do
                local p_pid=${p#/proc/}
                for fd in $p/fd/*; do
                    if [ -L "$fd" ]; then
                        local target=$(readlink "$fd")
                        if [[ "$target" == "socket:[$inode]" ]]; then
                            pid=$p_pid
                            break 2
                        fi
                    fi
                done
            done

            if [ -n "$pid" ]; then
                local proc_name=$(get_process_name "$pid")
                local pkg_name=$(get_package_name "$uid")
                local state_str=""
                case $st in
                    07) state_str="LISTEN" ;;
                    *) state_str="UNKNOWN" ;;
                esac
                printf "UDP | %-21s -> %-21s | %-12s | PID %-6d | %s | %s\n" \
                    "$local_ip_port" "$rem_ip_port" "$state_str" "$pid" "${proc_name:0:30}" "$pkg_name" >> "$tmpfile"
                ((count++))
            fi
        done < /proc/net/udp
    fi

    if [ $count -eq 0 ]; then
        echo -e "${YELLOW}No active network connections found.${NC}"
    else
        echo -e "${CYAN}Proto | Local Address       -> Remote Address      | State        | PID    | Process (trunc)                | Package${NC}"
        echo -e "${CYAN}─────────────────────────────────────────────────────────────────────────────────────────────────────────${NC}"
        cat "$tmpfile"
        echo -e "${CYAN}─────────────────────────────────────────────────────────────────────────────────────────────────────────${NC}"
        echo -e "Total active connections: ${GREEN}${count}${NC}"
    fi

    rm -f "$tmpfile"
    echo -e "${CYAN}Press any key to return.${NC}"
    read -n 1 -s
}

# Process States – uses rish
process_states() {
    clear
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}              Process States (via rish)${NC}"
    echo -e "${PURPLE}════════════════════════════════════════════════════════${NC}"
    echo ""

    local tmp=$(mktemp)
    local success=0

    if command -v rish >/dev/null 2>&1; then
        rish -c "dumpsys activity processes" 2>/dev/null | grep "Proc #" > "$tmp"
        if [ -s "$tmp" ]; then
            success=1
        fi
    fi

    if [ $success -eq 0 ] && [ -f ~/rish ]; then
        sh ~/rish -c "dumpsys activity processes" 2>/dev/null | grep "Proc #" > "$tmp"
        if [ -s "$tmp" ]; then
            success=1
        fi
    fi

    if [ $success -eq 0 ] && command -v adb >/dev/null 2>&1 && adb get-state 2>/dev/null | grep -q device; then
        adb shell dumpsys activity processes | grep "Proc #" > "$tmp"
        if [ -s "$tmp" ]; then
            success=1
        fi
    fi

    if [ $success -eq 1 ]; then
        printf "%-6s %-12s %-20s %s\n" "PID" "STATE" "PROCESS" "PACKAGE"
        echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"

        while read line; do
            local state=$(echo "$line" | awk '{print $3}')
            local pid_pkg=$(echo "$line" | grep -o '[0-9]\+:[^ ]\+' | head -1)
            local pid=$(echo "$pid_pkg" | cut -d: -f1)
            local pkg=$(echo "$pid_pkg" | cut -d: -f2 | cut -d/ -f1)
            local extra=$(echo "$line" | grep -o '([^)]*)' | head -1)

            case "$state" in
                fore)  state_desc="FOREGROUND" ;;
                vis)   state_desc="VISIBLE" ;;
                per)   state_desc="PERCEPTIBLE" ;;
                svc)   state_desc="SERVICE" ;;
                bak)   state_desc="BACKUP" ;;
                hvy)   state_desc="HEAVY" ;;
                stop)  state_desc="STOPPED" ;;
                rece)  state_desc="RECEIVER" ;;
                home)  state_desc="HOME" ;;
                last)  state_desc="LAST" ;;
                cch)   state_desc="CACHED" ;;
                *)     state_desc="$state" ;;
            esac

            printf "%-6s %-12s %-20s %s %s\n" "$pid" "$state_desc" "${pkg:0:20}" "$pkg" "$extra"
        done < "$tmp"
    else
        echo -e "${YELLOW}Could not retrieve process information.${NC}"
        echo ""
        echo "To use this feature, set up rish or adb."
    fi

    rm -f "$tmp"
    echo ""
    echo -e "${PURPLE}────────────────────────────────────────────────────────${NC}"
    echo -e "${PURPLE}Press any key to return.${NC}"
    read -n 1 -s
}

# Device Info – hardware, software, battery (via rish)
device_info() {
    clear
    echo -e "${PINK}════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}              Device Info (Hardware & Software)${NC}"
    echo -e "${PINK}════════════════════════════════════════════════════════${NC}"
    echo ""

    # Hardware info (from getprop)
    echo -e "${CYAN}Hardware:${NC}"
    echo -e "  Device:      $(getprop ro.product.manufacturer) $(getprop ro.product.model)"
    echo -e "  Board:       $(getprop ro.product.board)"
    echo -e "  Hardware:    $(getprop ro.hardware)"
    echo -e "  CPU ABI:     $(getprop ro.product.cpu.abi)"
    echo ""

    # Software info
    echo -e "${CYAN}Software:${NC}"
    echo -e "  Android:     $(getprop ro.build.version.release) (API $(getprop ro.build.version.sdk))"
    echo -e "  Security patch: $(getprop ro.build.version.security_patch)"
    echo -e "  Build ID:    $(getprop ro.build.display.id)"
    echo -e "  Kernel:      $(uname -r)"
    echo ""

    # Battery basics (via rish if available)
    echo -e "${CYAN}Battery (via rish):${NC}"
    local tmp=$(mktemp)
    local success=0

    if command -v rish >/dev/null 2>&1; then
        rish -c "dumpsys battery" 2>/dev/null > "$tmp"
        if [ -s "$tmp" ]; then
            success=1
        fi
    fi

    if [ $success -eq 0 ] && [ -f ~/rish ]; then
        sh ~/rish -c "dumpsys battery" 2>/dev/null > "$tmp"
        if [ -s "$tmp" ]; then
            success=1
        fi
    fi

    if [ $success -eq 1 ]; then
        local level=$(grep "level:" "$tmp" | awk '{print $2}')
        local status=$(grep "status:" "$tmp" | awk '{print $2}')
        local health=$(grep "health:" "$tmp" | awk '{print $2}')
        local temp=$(grep "temperature:" "$tmp" | awk '{print $2}')
        local voltage=$(grep "voltage:" "$tmp" | awk '{print $2}')
        local cycle=$(grep "cycle count:" "$tmp" | awk '{print $3}')
        local capacity=$(grep "capacity:" "$tmp" | awk '{print $2}')

        case "$status" in
            1) status_str="Unknown" ;;
            2) status_str="Charging" ;;
            3) status_str="Discharging" ;;
            4) status_str="Not charging" ;;
            5) status_str="Full" ;;
            *) status_str="$status" ;;
        esac

        case "$health" in
            1) health_str="Unknown" ;;
            2) health_str="Good" ;;
            3) health_str="Overheat" ;;
            4) health_str="Dead" ;;
            5) health_str="Over voltage" ;;
            6) health_str="Failure" ;;
            7) health_str="Cold" ;;
            *) health_str="$health" ;;
        esac

        echo "  Level:       $level%"
        echo "  Status:      $status_str"
        echo "  Health:      $health_str"
        if [ -n "$temp" ]; then
            echo "  Temperature: $(echo "scale=1; $temp/10" | bc) °C"
        fi
        if [ -n "$voltage" ]; then
            echo "  Voltage:     $(echo "scale=2; $voltage/1000" | bc) V"
        fi
        if [ -n "$cycle" ]; then
            echo "  Cycle count: $cycle"
        fi
        if [ -n "$capacity" ]; then
            echo "  Capacity:    $capacity%"
        fi
    else
        echo -e "  ${YELLOW}Battery info unavailable – rish not connected.${NC}"
    fi
    rm -f "$tmp"

    echo ""
    echo -e "${PINK}────────────────────────────────────────────────────────${NC}"
    echo -e "${PINK}Press any key to return.${NC}"
    read -n 1 -s
}

# Module order (puns as third column)
MODULE_ORDER=("integrity" "memory" "network" "behavior" "hook" "kernel" "miui")

declare -A MODULE_NAMES=(
    ["memory"]="Memory Scan"
    ["network"]="Network Monitor"
    ["integrity"]="File Watch"
    ["behavior"]="Process Behavior"
    ["hook"]="Hook Detection"
    ["kernel"]="Kernel Analysis"
    ["miui"]="MIUI Monitor"
)

declare -A MODULE_PUNS=(
    ["memory"]="Neil Daemon (Sweet Caroline)"
    ["network"]="H-TTPS Daemon Hunters"
    ["integrity"]="Bl-UUID Daemons"
    ["behavior"]="Daemons Are Forever"
    ["hook"]="Princess Dae(Mon)"
    ["kernel"]="Daemons Are a Girl's Best Friend"
    ["miui"]="Matt Daemon"
)

truncate_pun() {
    local pun="$1"
    local max_len=42
    if [ ${#pun} -gt $max_len ]; then
        echo "${pun:0:$((max_len-3))}..."
    else
        echo "$pun"
    fi
}

show_status() {
    clear
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "${YELLOW}                     MiuiserPeruser${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "Daemon: $(check_service) | Last scan: ${PURPLE}$(last_scan_time)${NC}"
    echo -e "Threats today: ${RED}$(threat_count_today)${NC} | Memory: ${BLUE}$(get_memory_usage)${NC}"
    echo ""
    printf "%-20s %-5s %s\n" "MODULE" "STATUS" "CHOOSE YOUR FIGHTER"
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    
    for mod in "${MODULE_ORDER[@]}"; do
        state="${STATE[$mod]:-0}"
        name="${MODULE_NAMES[$mod]}"
        pun="${MODULE_PUNS[$mod]}"
        
        if [ "$mod" = "network" ] && [ "$state" = "1" ]; then
            name="$name (limited)"
        fi
        
        pun_display=$(truncate_pun "$pun")
        
        if [ "$state" = "1" ]; then
            printf "%-20s ${GREEN}✓ ON${NC}     ${PINK}%s${NC}\n" "$name" "$pun_display"
        else
            printf "%-20s ${RED}✗ OFF${NC}    ${PINK}%s${NC}\n" "$name" "$pun_display"
        fi
    done
    
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    echo -e "${YELLOW}Menu:${NC}"
    echo "  A) Scan menu (full / quick)"
    echo "  B) Toggle fighters on/off"
    echo "  C) Live daemon feed (tail log)"
    echo "  D) Start/stop daemon"
    echo "  E) View file watchlist"
    echo "  F) Process States"
    echo "  G) Device Info (hardware + software + battery)"
    echo "  H) Exit"
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    echo -n "> Choice [A-H]: "
}

# Scan submenu
scan_menu() {
    while true; do
        clear
        echo -e "${YELLOW}Scan Menu${NC}"
        echo -e "${CYAN}────────────────────────────────────────────${NC}"
        echo "  1) Full scan (detailed)"
        echo "  2) Quick scan (summary)"
        echo "  3) Show last scan snapshot"
        echo "  X) Return to main menu"
        echo -e "${CYAN}────────────────────────────────────────────${NC}"
        read -p "> Choice: " scan_choice
        case $scan_choice in
            1)
                clear
                echo -e "${YELLOW}Running full scan...${NC}"
                echo -e "${PINK}────────────────────────────────────────────────────────${NC}"
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                $CLIENT FULL_SCAN
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                echo -e "${PINK}Scan complete. Press any key to return to scan menu.${NC}"
                read -n 1 -s
                ;;
            2)
                clear
                echo -e "${YELLOW}Running quick scan...${NC}"
                echo -e "${PINK}────────────────────────────────────────────────────────${NC}"
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                $CLIENT QUICK_SCAN   # we'll need to implement this command
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                echo -e "${PINK}Scan complete. Press any key to return to scan menu.${NC}"
                read -n 1 -s
                ;;
            3)
                clear
                echo -e "${YELLOW}Last Scan Snapshot${NC}"
                echo -e "${PINK}────────────────────────────────────────────────────────${NC}"
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                show_last_scan
                echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
                echo -e "${PINK}Snapshot end. Press any key to return to scan menu.${NC}"
                read -n 1 -s
                ;;
            [Xx]) return ;;
            *) echo -e "${RED}Invalid choice${NC}"; sleep 1 ;;
        esac
    done
}

live_feed() {
    clear
    echo -e "${YELLOW}Live daemon feed – Ctrl+C to return${NC}"
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    trap 'echo -e "\n${CYAN}────────────────────────────────────────────────────────${NC}"; return' INT
    tail -f "$LOG" | while read line; do
        if [[ "$line" == *"THREAT"* ]]; then
            echo -e "${RED}$line${NC}"
        elif [[ "$line" == *"WARN"* ]]; then
            echo -e "${YELLOW}$line${NC}"
        elif [[ "$line" == *"NETWORK"* ]]; then
            echo -e "${BLUE}$line${NC}"
        elif [[ "$line" == *"MEMORY"* ]]; then
            echo -e "${PURPLE}$line${NC}"
        elif [[ "$line" == *"Scanning runsv"* ]]; then
            echo -e "${CYAN}$line${NC} ${PINK}(runsv = Termux's service babysitter)${NC}"
        elif [[ "$line" == *"Scanning svlogd"* ]]; then
            echo -e "${CYAN}$line${NC} ${PINK}(svlogd = service log writer)${NC}"
        else
            echo "$line"
        fi
    done
}

toggle_modules() {
    while true; do
        clear
        echo -e "${YELLOW}CHOOSE YOUR FIGHTER – pick your squad${NC}"
        echo -e "${CYAN}────────────────────────────────────────────${NC}"
        
        letters=()
        for idx in "${!MODULE_ORDER[@]}"; do
            mod="${MODULE_ORDER[$idx]}"
            state="${STATE[$mod]:-0}"
            name="${MODULE_NAMES[$mod]}"
            pun="${MODULE_PUNS[$mod]}"
            pun_display=$(truncate_pun "$pun")
            letter=$(printf "\\x$(printf %x $((65+idx)))")
            letters+=("$letter")
            if [ "$state" = "1" ]; then
                echo -e "  ${GREEN}${letter})${NC} $name ${GREEN}ON${NC}  ${PINK}$pun_display${NC}"
            else
                echo -e "  ${RED}${letter})${NC} $name ${RED}OFF${NC} ${PINK}$pun_display${NC}"
            fi
        done
        
        echo -e "${CYAN}────────────────────────────────────────────${NC}"
        echo "  X) Return to main menu"
        read -p "> Toggle which fighter? " choice
        
        [[ "$choice" == "X" || "$choice" == "x" ]] && return
        
        found=-1
        for idx in "${!letters[@]}"; do
            [[ "${letters[$idx]}" == "$choice" ]] && { found=$idx; break; }
        done
        
        if [ $found -ge 0 ]; then
            mod="${MODULE_ORDER[$found]}"
            current_state="${STATE[$mod]:-0}"
            new_state=$((1 - current_state))
            echo -n "Turn $([ $new_state -eq 1 ] && echo "ON" || echo "OFF")? (y/n) "
            read confirm
            if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                $CLIENT TOGGLE $mod $([ $new_state -eq 1 ] && echo "on" || echo "off")
                STATE["$mod"]=$new_state
                sed -i "/^$mod=/d" "$CONFIG"
                echo "$mod=$new_state" >> "$CONFIG"
                echo "Done."
            fi
            sleep 1
        else
            echo "Invalid choice"; sleep 1
        fi
    done
}

control_daemon() {
    clear
    echo -e "${YELLOW}Daemon Control${NC}"
    if pgrep -f "miuiserperuser-daemon" > /dev/null; then
        echo "  S) Stop daemon"
        echo "  R) Restart daemon"
    else
        echo "  S) Start daemon"
    fi
    echo "  X) Back"
    read -p "> Choice: " d
    case $d in
        [Ss])
            if pgrep -f "miuiserperuser-daemon" > /dev/null; then
                pkill -f "miuiserperuser-daemon"
                echo "Stopped."
            else
                cd ~/MiuiserPeruser/build/src/daemon
                nohup ./miuiserperuser-daemon --console > "$LOG" 2>&1 &
                echo "Started."
            fi
            sleep 1
            ;;
        [Rr])
            pkill -f "miuiserperuser-daemon"
            sleep 1
            cd ~/MiuiserPeruser/build/src/daemon
            nohup ./miuiserperuser-daemon --console > "$LOG" 2>&1 &
            echo "Restarted."
            sleep 1
            ;;
        [Xx]) return ;;
        *) echo "Invalid"; sleep 1 ;;
    esac
}

view_cache() {
    clear
    echo -e "${YELLOW}File Watchlist – what files are being checked${NC}"
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    if [ -f ~/.miuiserperuser_integrity_cache ]; then
        echo "These are the SHA256 hashes of monitored files. If a file changes, you'll get a THREAT alert."
        echo ""
        cat ~/.miuiserperuser_integrity_cache | while read line; do
            echo -e "${CYAN}$line${NC}"
        done
    else
        echo "No cache yet. Run a scan first."
    fi
    echo -e "${CYAN}────────────────────────────────────────────────────────${NC}"
    read -p "Press Enter..."
}

# Main loop
while true; do
    show_status
    read choice
    case ${choice^^} in
        A) scan_menu ;;
        B) toggle_modules ;;
        C) live_feed ;;
        D) control_daemon ;;
        E) view_cache ;;
        F) process_states ;;
        G) device_info ;;
        H) clear; exit 0 ;;
        *) echo -e "${RED}Invalid choice${NC}"; sleep 1 ;;
    esac
done
