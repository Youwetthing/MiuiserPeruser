#!/data/data/com.termux/files/usr/bin/bash

DAEMON_PUNS=(
    "rocksteadyd|Neil Daemon - Memory Pressure"
    "bebopd|Marina & The Daemons - Deep Sleep"
    "leatherheadd|Bl-UUID Daemons - File Integrity"
    "metalheadd|Daemons Are Forever - Behaviour Watch"
    "ratkingd|Princess Dae(Mon) - Hook Detection"
    "shredderd|Daemons Are A Girl's Bestfriend - Kernel/Thermal"
    "granitord|Matt Daemon - MIUI Spy Hunter"
    "rahzerd|Shine Bright like a Daemon - Connectivity"
)

show_header() {
    clear
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║                 MiuiserPeruser Dashboard                     ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "MiuiserPeruser: Using our inner daemons to protect your device"
    echo ""
}

show_daemons_top() {
    echo "Choose Your Fighter(s)"
    echo "──────────────────────────────────────────────────────────────"
    echo "Status | Daemon [Pun]"
    echo "──────────────────────────────────────────────────────────────"
    local i=1
    for item in "${DAEMON_PUNS[@]}"; do
        daemon=$(echo "$item" | cut -d'|' -f1)
        pun=$(echo "$item" | cut -d'|' -f2)
        if pgrep -f "$daemon" > /dev/null 2>&1; then
            printf "  ●  | %s\n" "$pun"
        else
            printf "  ○  | %s (offline)\n" "$pun"
        fi
        i=$((i+1))
    done
    echo ""
}

main_menu() {
    show_header
    show_daemons_top
    echo "Main Menu"
    echo "──────────────────────────────────────────────────────────────"
    echo "  1) Superhero Mode / Full Scan"
    echo "  2) Choose Your Fighter(s) — Toggle daemons"
    echo "  3) View Latest Scan Results + Tips"
    echo "  4) Live Feed (all layers)"
    echo "  5) Stop / Force-Stop Syndicate"
    echo "  6) Tools & Settings"
    echo "  7) Exit"
    echo "──────────────────────────────────────────────────────────────"
    echo ""
}

full_scan_menu() {
    clear
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║               Superhero Mode / Full Scan                     ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "  1) Full scanning (rolling live feed)"
    echo "  2) Run in background"
    echo "  3) Run scan against online check"
    echo "     Recommended to run online check 1–2 times per week for best protection"
    echo ""
    echo "  0) Back to main menu"
    echo ""
}

while true; do
    main_menu
    read -p "Choice [1-7]: " choice
    case $choice in
        1)
            while true; do
                full_scan_menu
                read -p "Choice [0-3]: " subchoice
                case $subchoice in
                    1) echo "Launching deep rolling live feed..."; ./bin/superhero ;;
                    2) echo "Running Superhero in background..."; nohup ./bin/superhero > logs/superhero_background.log 2>&1 & echo "Background PID: $!"; ;;
                    3)
                        echo "Running local database check first..."
                        echo "No known bad MIUI packages detected locally."
                        echo ""
                        echo "Open browser for online check?"
                        echo "1) VirusTotal"
                        echo "2) Vietnamese MIUI forum (voz.vn)"
                        echo "3) Vietnamese tech forum (tinhte.vn)"
                        echo "4) Cancel"
                        read -p "Choice: " onlinechoice
                        case $onlinechoice in
                            1) termux-open-url "https://www.virustotal.com/gui/home/upload" ;;
                            2) termux-open-url "https://voz.vn/f/miui-hyperos.123/" ;;
                            3) termux-open-url "https://tinhte.vn/tag/miui" ;;
                            *) echo "Cancelled." ;;
                        esac
                        ;;
                    0) break ;;
                    *) echo "Invalid choice"; sleep 1 ;;
                esac
            done
            ;;
        7) echo "Goodbye!"; exit 0 ;;
        *) echo "Coming soon..."; sleep 1 ;;
    esac
done
