control_daemon() {
    clear
    echo -e "${BLUE}${TL}$(printf '%*s' 30 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${BLUE}${VL}${RESET} ${BOLD}DAEMON CONTROL${RESET}$(printf '%*s' 13) ${BLUE}${VL}${RESET}"
    echo -e "${BLUE}${BL}$(printf '%*s' 30 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    if pgrep -f "miuiserperuser-daemon" > /dev/null; then
        echo "  ${GREEN}S${RESET}) Stop daemon"; echo "  ${YELLOW}R${RESET}) Restart daemon"
    else
        echo "  ${GREEN}S${RESET}) Start daemon"
    fi
    echo "  ${RED}X${RESET}) Back"; echo ""; read -p "> Choice: " d
    case $d in
        [Ss])
            if pgrep -f "miuiserperuser-daemon" > /dev/null; then pkill -f "miuiserperuser-daemon"; echo "Stopped."
            else cd ~/MiuiserPeruser/build/src/daemon; nohup ./miuiserperuser-daemon --console > "$LOG" 2>&1 & echo "Started."; fi; sleep 1 ;;
