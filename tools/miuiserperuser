# ═══════════════════════════════════════════════════════════════════════════
#  FIRST RUN CONFIG
# ═══════════════════════════════════════════════════════════════════════════
if [ ! -f "$CONFIG" ]; then
    > "$CONFIG"
    echo "integrity=1" >> "$CONFIG"
    echo "memory=1" >> "$CONFIG"
    echo "network=1" >> "$CONFIG"
    echo "behavior=1" >> "$CONFIG"
    echo "hook=1" >> "$CONFIG"
    echo "kernel=0" >> "$CONFIG"
    echo "miui=1" >> "$CONFIG"
fi

declare -A STATE
while IFS='=' read -r mod val; do
    STATE["$mod"]="$val"
done < "$CONFIG"

# ═══════════════════════════════════════════════════════════════════════════
#  HELPER FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════
check_service() {
    if pgrep -f "miuiserperuser-daemon" > /dev/null; then
        echo -e "${GREEN}● RUNNING${RESET}"
        return 0
    else
        echo -e "${RED}○ OFFLINE${RESET}"
        return 1
    fi
}

last_scan_time() {
    if [ -f "$LOG" ]; then
        tail -n 50 "$LOG" | grep -E "(Full|Quick) scan finished" | tail -1 | cut -d' ' -f1-2
    else
        echo "Never"
    fi
}

threat_count_today() {
    if [ -f "$LOG" ]; then
        today=$(date +%Y-%m-%d)
        grep "$today" "$LOG" | grep -c "THREAT"
    else
        echo 0
    fi
}

get_memory_usage() {
    local mem_total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    local mem_avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    local swap_total=$(awk '/SwapTotal/ {print $2}' /proc/meminfo)
    local swap_free=$(awk '/SwapFree/ {print $2}' /proc/meminfo)
    local ram_used=0
    local swap_used=0
    if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ]; then
        ram_used=$(( 100 - (mem_avail * 100 / mem_total) ))
    fi
    if [ -n "$swap_total" ] && [ "$swap_total" -gt 0 ]; then
        swap_used=$(( (swap_total - swap_free) * 100 / swap_total ))
    fi
    echo "RAM ${ram_used}%  |  Swap ${swap_used}%"
}

show_last_scan() {
    if [ ! -f "$LOG" ]; then
        echo "No log file found."
        return
    fi
    local end_line=$(grep -n -E "(Full|Quick) scan finished" "$LOG" | tail -1 | cut -d: -f1)
    if [ -z "$end_line" ]; then
        echo "No scans recorded yet."
        return
    fi
    local start_line=$(head -n $end_line "$LOG" | grep -n -E "Starting (full|quick) system scan" | tail -1 | cut -d: -f1)
    if [ -z "$start_line" ]; then
        start_line=1
    fi
    sed -n "${start_line},${end_line}p" "$LOG"
}

background_processes() {
    local pids=()
    for pid in /proc/[0-9]*; do pid=${pid#/proc/}; pids+=("$pid"); done
    local count=0
    printf "%-6s %-15s %-6s %-8s %-7s %s\n" "PID" "NAME" "STATE" "CPU" "MEMORY" "COMMAND"
    echo -e "${DARK}${HL}$(printf '%*s' 75 | tr ' ' "${HL}")${RESET}"
    for pid in "${pids[@]}"; do
        local stat_file="/proc/$pid/stat"; local status_file="/proc/$pid/status"; local cmdline_file="/proc/$pid/cmdline"
        if [ ! -r "$stat_file" ] || [ ! -r "$status_file" ]; then continue; fi
        local ppid=$(awk '{print $4}' "$stat_file" 2>/dev/null)
        local name=$(grep "^Name:" "$status_file" 2>/dev/null | awk '{print $2}')
        local cmdline=$(cat "$cmdline_file" 2>/dev/null | tr '\0' ' ' | sed 's/ $//')
        [ -z "$cmdline" ] && cmdline="[$name]"
        if [ "$ppid" = "1" ] || [[ "$name" =~ sv|log|getty|daemon|init|systemd ]]; then
            local utime=$(awk '{print $14}' "$stat_file" 2>/dev/null)
            local stime=$(awk '{print $15}' "$stat_file" 2>/dev/null)
            local total_time=$((utime + stime)); local cpu_sec=$((total_time / 100)); local cpu_min=$((cpu_sec / 60)); cpu_sec=$((cpu_sec % 60))
            local cpu_time=$(printf "%02d:%02d" $cpu_min $cpu_sec)
            local mem_kb=$(grep "^VmRSS:" "$status_file" 2>/dev/null | awk '{print $2}')
            local mem=""; [ -n "$mem_kb" ] && { [ "$mem_kb" -ge 1024 ] && mem="$(echo "scale=1; $mem_kb/1024" | bc)M" || mem="${mem_kb}K"; } || mem="N/A"
            local state=$(awk '{print $3}' "$stat_file" 2>/dev/null)
            printf "%-6s %-15s %-6s %-8s %-7s\n" "$pid" "$name" "$state" "$cpu_time" "$mem"
            printf "      ${DARK}└─ %s${RESET}\n" "$cmdline"
            ((count++))
        fi
    done
    echo -e "${DARK}${HL}$(printf '%*s' 75 | tr ' ' "${HL}")${RESET}"
    echo -e "Total background processes: ${GREEN}${count}${RESET}"
}

active_connections() {
    clear
    echo -e "${CYAN}${TL}$(printf '%*s' 58 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${CYAN}${VL}${RESET} ${YELLOW}          ACTIVE NETWORK CONNECTIONS (SNAPSHOT)${RESET}          ${CYAN}${VL}${RESET}"
    echo -e "${CYAN}${BL}$(printf '%*s' 58 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    local tmpfile=$(mktemp); local count=0
    get_package_name() { local uid=$1; local pkg="?"; [ -f /data/system/packages.list ] && pkg=$(awk -v u="$uid" '$2 == u {print $1; exit}' /data/system/packages.list 2>/dev/null); [ -z "$pkg" ] && pkg="?"; echo "$pkg"; }
    get_process_name() { local pid=$1; if [ -r "/proc/$pid/cmdline" ]; then tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed 's/ $//'; else echo "?"; fi; }
    if [ -r /proc/net/tcp ]; then
        while read line; do
            [[ "$line" =~ ^[[:space:]]*sl ]] && continue
            local local_hex=$(echo "$line" | awk '{print $2}'); local rem_hex=$(echo "$line" | awk '{print $3}'); local st=$(echo "$line" | awk '{print $4}')
            local uid=$(echo "$line" | awk '{print $8}'); local inode=$(echo "$line" | awk '{print $10}')
            local local_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${local_hex:0:2} 0x${local_hex:3:2} 0x${local_hex:6:2} 0x${local_hex:9:2} 0x${local_hex:12} 2>/dev/null)
            local rem_ip_port=$(printf "%d.%d.%d.%d:%d" 0x${rem_hex:0:2} 0x${rem_hex:3:2} 0x${rem_hex:6:2} 0x${rem_hex:9:2} 0x${rem_hex:12} 2>/dev/null)
            local pid=""; for p in /proc/[0-9]*; do local p_pid=${p#/proc/}; for fd in $p/fd/*; do if [ -L "$fd" ]; then local target=$(readlink "$fd"); if [[ "$target" == "socket:[$inode]" ]]; then pid=$p_pid; break 2; fi; fi; done; done
            if [ -n "$pid" ]; then
                local proc_name=$(get_process_name "$pid"); local pkg_name=$(get_package_name "$uid")
                local state_str=""; case $st in 01) state_str="ESTABLISHED";; 02) state_str="SYN_SENT";; 03) state_str="SYN_RECV";; 04) state_str="FIN_WAIT1";; 05) state_str="FIN_WAIT2";; 06) state_str="TIME_WAIT";; 07) state_str="CLOSE";; 08) state_str="CLOSE_WAIT";; 09) state_str="LAST_ACK";; 0A) state_str="LISTEN";; 0B) state_str="CLOSING";; *) state_str="UNKNOWN";; esac
                printf "TCP | %-21s -> %-21s | %-12s | PID %-6d | %s | %s\n" "$local_ip_port" "$rem_ip_port" "$state_str" "$pid" "${proc_name:0:30}" "$pkg_name" >> "$tmpfile"
                ((count++))
            fi
        done < /proc/net/tcp
    fi
    if [ $count -eq 0 ]; then echo -e "${YELLOW}No active network connections found.${RESET}"; else
        echo -e "${DARK}Proto | Local Address       -> Remote Address      | State        | PID    | Process (trunc)                | Package${RESET}"
        echo -e "${DARK}─────────────────────────────────────────────────────────────────────────────────────────────────────────${RESET}"
        cat "$tmpfile"
        echo -e "${DARK}─────────────────────────────────────────────────────────────────────────────────────────────────────────${RESET}"
        echo -e "Total active connections: ${GREEN}${count}${RESET}"
    fi
    rm -f "$tmpfile"
    echo -e "\n${CYAN}Press any key to return.${RESET}"; read -n 1 -s
}

process_states() {
    clear
    echo -e "${PURPLE}${TL}$(printf '%*s' 58 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${PURPLE}${VL}${RESET} ${YELLOW}              PROCESS STATES (VIA RISH)${RESET}                     ${PURPLE}${VL}${RESET}"
    echo -e "${PURPLE}${BL}$(printf '%*s' 58 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    local tmp=$(mktemp); local success=0
    if command -v rish >/dev/null 2>&1; then rish -c "dumpsys activity processes" 2>/dev/null | grep "Proc #" > "$tmp" && [ -s "$tmp" ] && success=1; fi
    if [ $success -eq 0 ] && [ -f ~/rish ]; then sh ~/rish -c "dumpsys activity processes" 2>/dev/null | grep "Proc #" > "$tmp" && [ -s "$tmp" ] && success=1; fi
    if [ $success -eq 0 ] && command -v adb >/dev/null 2>&1 && adb get-state 2>/dev/null | grep -q device; then adb shell dumpsys activity processes | grep "Proc #" > "$tmp" && [ -s "$tmp" ] && success=1; fi
    if [ $success -eq 1 ]; then
        printf "%-6s %-12s %-20s %s\n" "PID" "STATE" "PROCESS" "PACKAGE"
        echo -e "${DARK}────────────────────────────────────────────────────────────────────────${RESET}"
        while read line; do
            local state=$(echo "$line" | awk '{print $3}'); local pid_pkg=$(echo "$line" | grep -o '[0-9]\+:[^ ]\+' | head -1)
            local pid=$(echo "$pid_pkg" | cut -d: -f1); local pkg=$(echo "$pid_pkg" | cut -d: -f2 | cut -d/ -f1); local extra=$(echo "$line" | grep -o '([^)]*)' | head -1)
            case "$state" in
                fore) state_desc="FOREGROUND";; vis) state_desc="VISIBLE";; per) state_desc="PERCEPTIBLE";; svc) state_desc="SERVICE";; bak) state_desc="BACKUP";; hvy) state_desc="HEAVY";; stop) state_desc="STOPPED";; rece) state_desc="RECEIVER";; home) state_desc="HOME";; last) state_desc="LAST";; cch) state_desc="CACHED";; *) state_desc="$state";;
            esac
            printf "%-6s %-12s %-20s %s %s\n" "$pid" "$state_desc" "${pkg:0:20}" "$pkg" "$extra"
        done < "$tmp"
    else
        echo -e "${YELLOW}Could not retrieve process information.${RESET}"; echo ""; echo "To use this feature, set up rish or adb."
    fi
    rm -f "$tmp"
    echo -e "\n${PURPLE}Press any key to return.${RESET}"; read -n 1 -s
}

device_info() {
    clear
    echo -e "${PINK}${TL}$(printf '%*s' 58 | tr ' ' "${HL}")${TR}${RESET}"
    echo -e "${PINK}${VL}${RESET} ${YELLOW}              DEVICE INFO (HARDWARE & SOFTWARE)${RESET}                 ${PINK}${VL}${RESET}"
    echo -e "${PINK}${BL}$(printf '%*s' 58 | tr ' ' "${HL}")${BR}${RESET}"
    echo ""
    echo -e "${CYAN}${BOLD}HARDWARE${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
    echo -e "  Device:      $(getprop ro.product.manufacturer) $(getprop ro.product.model)"
    echo -e "  Board:       $(getprop ro.product.board)"; echo -e "  Hardware:    $(getprop ro.hardware)"; echo -e "  CPU ABI:     $(getprop ro.product.cpu.abi)"
    echo -e "\n${CYAN}${BOLD}SOFTWARE${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
    echo -e "  Android:     $(getprop ro.build.version.release) (API $(getprop ro.build.version.sdk))"
    echo -e "  Security:    $(getprop ro.build.version.security_patch)"; echo -e "  Build ID:    $(getprop ro.build.display.id)"; echo -e "  Kernel:      $(uname -r)"
    echo -e "\n${CYAN}${BOLD}BATTERY (VIA RISH)${RESET}"; echo -e "${DARK}────────────────────────────────────────────────────────${RESET}"
    local tmp=$(mktemp); local success=0
    if command -v rish >/dev/null 2>&1; then rish -c "dumpsys battery" 2>/dev/null > "$tmp" && [ -s "$tmp" ] && success=1; fi
    if [ $success -eq 0 ] && [ -f ~/rish ]; then sh ~/rish -c "dumpsys battery" 2>/dev/null > "$tmp" && [ -s "$tmp" ] && success=1; fi
    if [ $success -eq 1 ]; then
        local level=$(grep "level:" "$tmp" | awk '{print $2}'); local status=$(grep "status:" "$tmp" | awk '{print $2}'); local health=$(grep "health:" "$tmp" | awk '{print $2}')
        local temp=$(grep "temperature:" "$tmp" | awk '{print $2}'); local voltage=$(grep "voltage:" "$tmp" | awk '{print $2}'); local cycle=$(grep "cycle count:" "$tmp" | awk '{print $3}')
        case "$status" in 1) status_str="Unknown";; 2) status_str="Charging";; 3) status_str="Discharging";; 4) status_str="Not charging";; 5) status_str="Full";; *) status_str="$status";; esac
        case "$health" in 1) health_str="Unknown";; 2) health_str="Good";; 3) health_str="Overheat";; 4) health_str="Dead";; 5) health_str="Over voltage";; 6) health_str="Failure";; 7) health_str="Cold";; *) health_str="$health";; esac
        echo "  Level:       $level%"; echo "  Status:      $status_str"; echo "  Health:      $health_str"
        [ -n "$temp" ] && echo "  Temperature: $(echo "scale=1; $temp/10" | bc) °C"
        [ -n "$voltage" ] && echo "  Voltage:     $(echo "scale=2; $voltage/1000" | bc) V"
        [ -n "$cycle" ] && echo "  Cycle count: $cycle"
    else
        echo -e "  ${YELLOW}Battery info unavailable – rish not connected.${RESET}"
    fi
    rm -f "$tmp"
    echo -e "\n${PINK}Press any key to return.${RESET}"; read -n 1 -s
}

