#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include "turtle_bridge.h"
#include "syndicate_db.h"

extern void syndicate_broadcast(const char *msg);
extern int splinter_status_check();
extern int leatherhead_io_audit();

int main(void) {
typedef struct { int threat_level; char summary[256]; } ScanResult;
ScanResult scan_casey_input(void);
    syndicate_db_init("/data/data/com.termux/files/home/MiuiserPeruser/data/syndicate.db");
    
    printf("🔄 [POWERHOUSE] Syndicate Flip Switch: ON\n");
    printf("📡 [SOCKET] Unix Domain Socket Active at /tmp/syndicate.sock\n");

    while (1) {
        // Run the Full Squad
        ScanResult leo = scan_leo_strategy();
        ScanResult don = scan_don_integrity();
        ScanResult mikey = scan_mikey_miui();
        ScanResult raph = scan_raph_network();
        ScanResult casey = scan_casey_input();
        
        // Extra Daemons
        int splinter = splinter_status_check();
        int leather = leatherhead_io_audit();

        // The Flip Switch: Broadcast to Unix Socket
        char buffer[512];
        snprintf(buffer, sizeof(buffer), "LEO:%.2f|DON:%.2f|MIK:%.2f|RAP:%.2f|CAS:%.2f|SPL:%d|LTH:%d", 
                 leo.anomaly_score, don.anomaly_score, mikey.anomaly_score, 
                 raph.anomaly_score, casey.anomaly_score, splinter, leather);
        
        syndicate_broadcast(buffer);
        
        // Still log to DB for the Sentinel
        syndicate_db_log("CORE", "HEARTBEAT", buffer);

        usleep(500000); // High-speed 0.5s intervals for the powerhouse
    }
    return 0;
}
